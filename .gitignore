# EQUIPA — .gitignore
# Config files (generated by setup wizard, contain local paths)
forge_config.json
mcp_config.json
.mcp.json

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# OS junk
desktop.ini
Thumbs.db
.DS_Store
nul
~$*

# IDE files
.vs/
.vscode/
.idea/
*.swp
*.swo

# Claude temp files
tmpclaude-*

# Logs
*.log
forge_orchestrator.log
forgesmith.log

# ForgeSmith runtime data
.forgesmith-backups/
.forge-checkpoints/

# Agent state persistence (anti-compaction, ephemeral working state)
.forge-state.json

# Security audit reports (contain pre-refactor vulnerability details)
SECURITY-AUDIT-REPORT.md

# Security review reports (project-specific, contain vulnerability details)
SECURITY-REVIEW-*.md

# Autoresearch backups (prompt mutation history)
.autoresearch-backups/

# Training data (generated, may contain project-specific content)
*.jsonl

# Local Claude settings
.claude/settings.local.json

# Project manifest (generated by Athena)
project-manifest.json

# Semgrep cache
.semgrep/

# Dispatch config (contains local paths/settings)
dispatch_config.json


# Training scripts (Forgeborn-specific, not for public repo)
train_qlora*.py

# Local config (users create from .example files)
forge_config.json
dispatch_config.json
mcp_config.json
forgesmith_config.json

# EQUIPA agent task output artifacts (auto-generated summaries)
*-[0-9][0-9][0-9][0-9].md
SPLIT-PHASE*.md
ANTI-COMPACTION-*.md
LANG-PROMPTS-*.md
FEATURE-FLAGS-*.md
TEST-*.md
INTEGRATION-TEST-*.md
MODULE-DEPS-*.md
QVALUE-FEEDBACK-*.md
GEPA-EPISODE-CHECK-*.md
SIMBA-EPISODE-BIAS-*.md
INSTALL-TEST-*.md
NARRATIONS-*.md
RESEED-DATA-*.md
FONT-SIZE-*.md
QA-WYSIWYG-*.md
NEW-CUSTOMER-INLINE-*.md
WYSIWYG-EDITOR-*.md

# Skill manifest (auto-generated, regenerate with --regenerate-manifest)
skill_manifest.json

# Internal project context (not user-facing documentation)
CLAUDE.md

# Pytest cache
.pytest_cache/

# Research/analysis reports (internal, not documentation)
ecc-vs-equipa-analysis.md
LANDSCAPE-REPORT-*.md
MONOLITH-SPLIT-PLAN.md
ECC-IMPLEMENTATION-PLAN.md
docs-config.json
tmp-*.md

# Generated files
project-manifest.json
skill_manifest.json
docs-config.json
docs/html/
theforge.db
RETRY-*.md
TOOL_RESULT_STORAGE*.md

# Training data and eval artifacts
training_data/
training-data/
training_data_stats.json
tools/eval_coding_benchmark.py
tools/prepare_unified_training_data.py

# Stale root-level duplicates (real modules in equipa/ and scripts/)
/lessons.py
/loops.py
/parsing.py
/analyze_performance.py
/autoresearch_loop.py
/autoresearch_prompts.py
/forgesmith_backfill.py
/forgesmith_impact.py
/nightly_review.py

# Manifest regenerated at runtime
skill_manifest.json
equipa/constants.py.bak

.plugin-boundary-markers

# Benchmark results and artifacts
benchmarks/EQUIPA*.json
benchmarks/*.swebench-venv/
benchmarks/FeatureBench/
benchmarks/eval_outputs/
benchmarks/logs/
benchmarks/report.json
benchmarks/fb_*.json
benchmarks/fb_*.jsonl
benchmarks/swebench_*.json
benchmarks/swebench_*.jsonl
benchmarks/container_dbs/
benchmarks/*_full.json
benchmarks/test_*.json
benchmarks/first_50_instances.txt

# QIAO — private, never commit to public repo
prompts/qiao-*.md
skills/qiao-*/
**/qiao/
qiao*.py
# Belt-and-braces (Phase 0.2): catch qiao-named artifacts anywhere in the tree
**/qiao_*.md
**/*_qiao_*
**/qiao-*.md

# Task outputs (agent working dirs)
task-outputs/

# Runtime logs
logs/

# EQUIPA agent artifacts - stay out of public repo
.equipa-artifacts/
/SECURITY-REVIEW-*.md
/CODE-REVIEW-*.md
/PLAN-*.md
/RETRY-IMPLEMENTATION-*.md
/GEPA-EPISODE-CHECK-*.md
/LEAN-CTX-PORT.md
